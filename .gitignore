# Python (legacy)
__pycache__/
*.pyc
*.db
*.sqlite
.pytest_cache/
venv/
.venv/
# setuptools build metadata — auto-generated by `pip install -e .`, never hand-edited
*.egg-info/

# Go
bin/
go/bin/
# ...but rust/src/bin holds Rust SOURCE binary targets (e.g. the parity harness),
# not build output — that lives in rust/target. Re-include it past the broad bin/ rule.
!rust/src/bin/
!rust/src/bin/*.rs
# stray binaries from `go build ./cmd/api` (etc.) run outside go/bin/
/go/api
/go/vibesynth
/go/statcommentary

# Environment
# .env is the committed template (safe defaults, no secrets).
# .env.local holds real values and is ignored.
.env.local

# Logs
*.log
logs/
