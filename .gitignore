# Python (legacy)
__pycache__/
*.pyc
*.db
*.sqlite
.pytest_cache/
venv/
.venv/
# setuptools build metadata — auto-generated by `pip install -e .`, never hand-edited
*.egg-info/

# Go
bin/
go/bin/
# ...but rust/src/bin holds Rust SOURCE binary targets (e.g. the parity harness),
# not build output — that lives in rust/target. Re-include it past the broad bin/ rule.
!rust/src/bin/
!rust/src/bin/*.rs
# stray binaries from `go build ./cmd/api` (etc.) run outside go/bin/
/go/api
/go/vibesynth
/go/statcommentary
/go/validate-stmts

# Environment
# .env is the committed template (safe defaults, no secrets).
# .env.local holds real values and is ignored.
.env.local
# ...and EVERY backup of it. A `.bak` of .env.local holds the same live secrets as
# .env.local itself, and the bare `.env.local` rule above did not match the suffixed
# copies — which is exactly how `.env.local.bak.20260726-111052` (40 populated values:
# DB URLs, JWT_SECRET, provider keys, Twitter tokens) got committed in 47e69a7 and
# pushed to origin. Both spellings in use across the two machines are covered here.
.env.local*
.env*.bak*
.env.local.bak*

# Claude Code local settings (per-machine; accrues ad-hoc Bash permission grants
# that can embed secrets — this is how the F-046 Postgres/Neon creds leaked).
# The SHARED .claude/settings.json + .claude/hooks/ stay TRACKED on purpose.
.claude/settings.local.json
# Claude Code session lockfiles (live PIDs/timestamps — pure ephemera).
**/.claude/scheduled_tasks.lock

# Logs
*.log
logs/
# The single env file is .env.local. A second .env is what caused the
# load-order confusion; do not recreate it (RUNBOOK 11.1).
.env

# Adjacent project with its own .git — lives in the working dir, never part of
# the backend. Ignored so git status stays quiet.
openlens-qr/
