# Merge with the existing Archbox database and CLASSIFIER_URL settings.
# Apply through migration 315 during coverage, with workers stopped.
COGNITION_STAGES=classifier
CLASSIFIER_REPLAY_BACKLOG=true
COGNITION_COVERAGE_CONTROLLER=true
DERIVE_WORKER_ENABLED=false
# Disable scoracle-classifier-source.service and scoracle-reader.service.
# Remove a legacy cognition service reader.conf dependency; reload systemd.
# scoracle-coverage.service runs Go's hourly RSS monitor; no local character model.
