# Merge with the existing shared database connection. No acquisition or Classifier.
# Keep paused until coordinated daily enrollment; daytime eval never claims work.
COGNITION_STAGES=narratives,vibe,rating,transfers,momentum,sigil
COGNITION_COVERAGE_CONTROLLER=false
DERIVE_WORKER_ENABLED=false
MODEL_BASE_URL=http://127.0.0.1:8080
MODEL_NAME=replace-with-local-model-alias
MODEL_MAX_CONCURRENT=1
COGNITION_BACKEND_CONCURRENCY=http://127.0.0.1:8080=1,http://127.0.0.1:8081=1
VOICE_NUM_CTX=32768
# Other routes inherit MODEL_NAME; emotional reading uses the qualified Qwen server.
COGNITION_ROUTE_NARRATIVE_LOGIC=
COGNITION_ROUTE_NARRATIVE_LOGIC_BASE_URL=http://127.0.0.1:8080
COGNITION_ROUTE_NARRATIVE_LOGIC_BACKEND=llamacpp
COGNITION_ROUTE_VIBE_LOGIC=Qwen3.5-4B-Q4_K_M
COGNITION_ROUTE_VIBE_LOGIC_BASE_URL=http://127.0.0.1:8081
COGNITION_ROUTE_VIBE_LOGIC_BACKEND=llamacpp
COGNITION_ROUTE_VIBE_LOGIC_THINK=false
COGNITION_ROUTE_STATS_LOGIC=
COGNITION_ROUTE_STATS_LOGIC_BASE_URL=http://127.0.0.1:8080
COGNITION_ROUTE_STATS_LOGIC_BACKEND=llamacpp
COGNITION_ROUTE_TRANSFER_LOGIC=
COGNITION_ROUTE_TRANSFER_LOGIC_BASE_URL=http://127.0.0.1:8080
COGNITION_ROUTE_TRANSFER_LOGIC_BACKEND=llamacpp
COGNITION_ROUTE_MOMENTUM_LOGIC=
COGNITION_ROUTE_MOMENTUM_LOGIC_BASE_URL=http://127.0.0.1:8080
COGNITION_ROUTE_MOMENTUM_LOGIC_BACKEND=llamacpp
COGNITION_ROUTE_ORACLE_LOGIC=
COGNITION_ROUTE_ORACLE_LOGIC_BASE_URL=http://127.0.0.1:8080
COGNITION_ROUTE_ORACLE_LOGIC_BACKEND=llamacpp
