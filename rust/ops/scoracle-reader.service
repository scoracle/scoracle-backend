[Unit]
Description=Scoracle shared URL reader (browser rendering and article content)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=READER_RUNTIME_DIR=%h/.local/share/scoracle-reader/vendor
Environment=READER_CHROME_EXECUTABLE=%h/.local/share/scoracle-reader/chrome/chrome
WorkingDirectory=%h/.local/share/scoracle-reader/vendor
ExecStart=%h/.local/share/scoracle-reader/node/bin/node %h/.local/share/scoracle-reader/start-reader.cjs
ExecStartPost=/usr/bin/curl --retry 10 --retry-connrefused --retry-delay 1 --max-time 2 --fail --silent --output /dev/null http://127.0.0.1:8301/docs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
