# Scoracle cron schedule — example crontab entries.
#
# Install with:
#   crontab scripts/hosting/crontab.example
# or merge into your existing crontab with `crontab -e`.
#
# IMPORTANT: cron runs in the system local timezone unless you set TZ.
# Arch defaults to whatever timedatectl reports. Check with:
#   timedatectl status
# If your system is in UTC, translate 23:00 ET:
#   EDT (Mar-Nov): 03:00 UTC next day  →  0 3 * * *
#   EST (Nov-Mar): 04:00 UTC next day  →  0 4 * * *
# Or set TZ=America/New_York at the top of this file to sidestep it.
TZ=America/New_York

# Make sure logs dir exists before cron writes to it:
#   mkdir -p /home/sheneveld/scoracle-backend/logs

# ---------------------------------------------------------------------------
# Football event draining — daily
# ---------------------------------------------------------------------------
# Runs at 23:00 ET. Late enough that every European match of the day has
# finished AND SportMonks has finalized lineup data. See
# planning_docs/CRON_SEEDING_STRATEGY.md for the reasoning.
0 23 * * * /home/sheneveld/scoracle-backend/scripts/hosting/cron-scoseed.sh event process --sport football --season 2025 >> /home/sheneveld/scoracle-backend/logs/cron-football.log 2>&1

# ---------------------------------------------------------------------------
# Football schedule + roster refresh — weekly (Monday 23:00 ET)
# ---------------------------------------------------------------------------
# Catches postponements, new signings, jersey changes. Larger call count
# (~400 SportMonks req) but only once a week.
0 23 * * 1 /home/sheneveld/scoracle-backend/scripts/hosting/cron-scoseed.sh event load-fixtures football --season 2025 >> /home/sheneveld/scoracle-backend/logs/cron-football.log 2>&1
30 23 * * 1 /home/sheneveld/scoracle-backend/scripts/hosting/cron-scoseed.sh meta seed football --season 2025 >> /home/sheneveld/scoracle-backend/logs/cron-football.log 2>&1

# ---------------------------------------------------------------------------
# Postgres backup — nightly 04:00 local
# ---------------------------------------------------------------------------
# Scheduled after the seeder so nightly backups capture the latest data.
0 4 * * * /home/sheneveld/scoracle-backend/scripts/hosting/backup-postgres.sh >> /home/sheneveld/scoracle-backend/logs/backup.log 2>&1

# ---------------------------------------------------------------------------
# Vibe corpus — once daily, RSS-driven coverage of every team
# ---------------------------------------------------------------------------
# Corpus mode RSS-sweeps every team in NBA/NFL/FOOTBALL, then runs Gemma
# only on entities that picked up fresh news in the sweep. No fixture filter,
# no tier filter — so coverage doesn't collapse during offseason or for
# eliminated teams. Cross-entity linking surfaces co-mentioned players for
# free, so the player layer rides along without per-player RSS calls.
#
# One pass per day (midnight ET) gives every team a full overnight refresh.
# The former noon pass is now redundant: the in-API news-spike LISTEN/NOTIFY
# worker (5 articles in 60 min → immediate Gemma rescoring) covers breaking
# cycles in real time, so we no longer need a second batch to stay within ~12h
# of fresh news. -corpus-skip-recent-hours 10 (default) still guards against
# re-scoring entities the spike worker just covered.
0 0 * * * /home/sheneveld/scoracle-backend/scripts/hosting/cron-vibe.sh -mode corpus >> /home/sheneveld/scoracle-backend/logs/vibe-corpus.log 2>&1

# ---------------------------------------------------------------------------
# Entity tier recomputation — weekly (Monday 02:00 ET)
# ---------------------------------------------------------------------------
# Rankings shift as the season progresses. One cheap SQL function call per
# sport (<1s). Scheduled before the Monday weekly meta refresh so the new
# tiers inform that run.
0 2 * * 1 /home/sheneveld/scoracle-backend/scripts/hosting/recompute-tiers.sh >> /home/sheneveld/scoracle-backend/logs/tier-recompute.log 2>&1

# ---------------------------------------------------------------------------
# NBA / NFL event seeding — intentionally absent from cron.
# BDL supports webhook subscriptions; those will drive event processing
# when wired up (see planning_docs/CRON_SEEDING_STRATEGY.md).
# ---------------------------------------------------------------------------
