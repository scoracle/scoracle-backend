[Unit]
Description=Scoracle Data API (self-hosted)
After=network-online.target
Wants=network-online.target
# Unlimited automatic restarts — matches the proven live policy. The API fails
# fast in production when Postgres is unavailable (see go/cmd/api/main.go), and
# we WANT it to come straight back the instant Postgres returns. Disabling the
# rapid-crash backstop (StartLimitIntervalSec=0) is deliberate: a Postgres
# restart must not be able to wedge the API permanently into a failed state.
# (StartLimitIntervalSec belongs in [Unit], not [Service].)
StartLimitIntervalSec=0

[Service]
Type=simple
# __SCORACLE_REPO_ROOT__ is rendered to the real repo path by
# scripts/hosting/install.sh at install time. Do not hardcode a path here —
# that is exactly the stale-path defect Session 2 of the audit removed.
WorkingDirectory=__SCORACLE_REPO_ROOT__
# ONE env file (consolidated 2026-08-01, RUNBOOK 11.1). There is no .env any more.
# The old two-file overlay (.env then .env.local, later silently overwriting earlier)
# made a key's effective value depend on load order; do not re-add a second file.
EnvironmentFile=-__SCORACLE_REPO_ROOT__/.env.local
ExecStart=__SCORACLE_REPO_ROOT__/go/bin/scoracle-api
Restart=always
RestartSec=3

# Logs go to the journal; view with:
#   journalctl --user -u scoracle-api -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scoracle-api

[Install]
WantedBy=default.target
