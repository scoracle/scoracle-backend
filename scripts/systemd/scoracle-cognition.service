[Unit]
Description=Scoracle Cognition Harness (Rust pipeline_work consumer)
After=network-online.target
Wants=network-online.target
# Unlimited automatic restarts — same rationale as scoracle-api: the worker fails
# fast when Postgres or Ollama is unavailable and we WANT it back the instant they
# return. Disabling the rapid-crash backstop (StartLimitIntervalSec=0) is deliberate
# so a Postgres/Ollama restart can never wedge the daemon permanently into a failed
# state. (StartLimitIntervalSec belongs in [Unit], not [Service].)
StartLimitIntervalSec=0

[Service]
Type=simple
# __SCORACLE_REPO_ROOT__ is rendered to the real repo path by
# scripts/hosting/install.sh at install time. Do not hardcode a path here.
WorkingDirectory=__SCORACLE_REPO_ROOT__
# EnvironmentFile order matters: systemd loads sequentially and DOES overwrite on
# later files. Load .env first (committed template), then .env.local (real values)
# wins. The Rust crate reads os::env directly (it does NOT load .env.local itself),
# so these files are how the daemon gets DATABASE_PRIVATE_URL + OLLAMA_* — the same
# files scoracle-api reads, so both processes see one config.
EnvironmentFile=-__SCORACLE_REPO_ROOT__/.env
EnvironmentFile=-__SCORACLE_REPO_ROOT__/.env.local
# Step 3 full cutover + headlines fold-in: Rust owns every live pipeline_work LLM stage
# (scrub → peak → transfers → narratives → vibe → sigil); Go is ingest + serve. The sigil
# stage is terminal and runs decide → voice in-process (the oracle stage folded in,
# Session B 2026-07-16; a stale 'oracle' in this list is warned about and ignored).
# Keep DERIVE_WORKER_ENABLED=false in .env.local so the Go API does not claim these
# same stages. PEAK is drained by the Rust daemon; `rust/bin/statcommentary` produces nightly PEAK work and handles explicit backfill.
# NOTE: .env.local also sets COGNITION_STAGES and, loading later, OVERRIDES this line —
# keep the two in sync (this one documents the production set for a fresh install).
Environment=COGNITION_STAGES=scrub,peak,momentum,transfers,narratives,vibe,sigil
ExecStart=__SCORACLE_REPO_ROOT__/rust/bin/scoracle-cognition
Restart=always
RestartSec=3
# The daemon handles SIGINT and SIGTERM itself (worker.rs supervisor task, post the
# 2026-07-15 incident hardening): the drain stops at the next item boundary, releases
# unprocessed claims back to 'pending', and a 75s in-process grace aborts a stuck
# in-flight item — always inside systemd's default TimeoutStopSec (90s), so a stop
# never escalates to SIGKILL. KillSignal stays SIGINT so this unit behaves identically
# under a pre-hardening binary (which only caught SIGINT, and only between ticks).
KillSignal=SIGINT

# Logs go to the journal; view with:
#   journalctl --user -u scoracle-cognition -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scoracle-cognition

[Install]
WantedBy=default.target
