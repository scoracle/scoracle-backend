[Unit]
Description=Scoracle Cognition Harness (Rust pipeline_work consumer)
After=network-online.target
Wants=network-online.target
# Unlimited automatic restarts — same rationale as scoracle-api: the worker fails
# fast when Postgres or Ollama is unavailable and we WANT it back the instant they
# return. Disabling the rapid-crash backstop (StartLimitIntervalSec=0) is deliberate
# so a Postgres/Ollama restart can never wedge the daemon permanently into a failed
# state. (StartLimitIntervalSec belongs in [Unit], not [Service].)
StartLimitIntervalSec=0

[Service]
Type=simple
# __SCORACLE_REPO_ROOT__ is rendered to the real repo path by
# scripts/hosting/install.sh at install time. Do not hardcode a path here.
WorkingDirectory=__SCORACLE_REPO_ROOT__
# ONE env file (consolidated 2026-08-01, RUNBOOK 11.1). There is no .env any more.
# The Rust crate reads os::env directly (it does NOT load .env.local itself), so this
# file is how the daemon gets DATABASE_PRIVATE_URL + OLLAMA_* — the same file
# scoracle-api reads, so both processes see one config. Do not re-add a second file:
# the old .env/.env.local overlay made a key's value depend on load order.
EnvironmentFile=-__SCORACLE_REPO_ROOT__/.env.local
# Rust owns every live pipeline_work LLM stage; Go is ingest + serve. The list below IS
# the production set (single-box consolidation, 2026-08-20 — all stages on archbox's
# ministral-3:3b). `rating` is the renamed `peak` (mig 221); `rust/bin/statcommentary`
# produces its nightly work and handles explicit backfill. The sigil stage is terminal
# and runs decide → voice in-process. Keep DERIVE_WORKER_ENABLED=false in .env.local so
# the Go API does not claim these same stages.
# NOTE: .env.local also sets COGNITION_STAGES and, loading later, OVERRIDES this line —
# keep the two in sync (this one documents the production set for a fresh install).
# main.rs tolerates RETIRED stage names (oracle/scrub/article_read/peak: warn, then boot)
# precisely so a box running a stale copy of this file does not fail closed — but nothing
# claims them; do not re-add them here.
# `editor` is THE reader: it reads every arrival on ep1 and writes editor_reads +
# news_articles.full_text. `investigate_entity` is the Investigator's discovery stage
# (Wikidata structured claims, zero model calls in v1), registered after the editor —
# the Editor outranks it.
Environment=COGNITION_STAGES=graph,editor,investigate_entity,rating,momentum,transfers,narratives,vibe,sigil
ExecStart=__SCORACLE_REPO_ROOT__/rust/bin/scoracle-cognition
Restart=always
RestartSec=3
# The daemon handles SIGINT and SIGTERM itself (worker.rs supervisor task, post the
# 2026-07-15 incident hardening): the drain stops at the next item boundary, releases
# unprocessed claims back to 'pending', and a 75s in-process grace aborts a stuck
# in-flight item — always inside systemd's default TimeoutStopSec (90s), so a stop
# never escalates to SIGKILL. KillSignal stays SIGINT so this unit behaves identically
# under a pre-hardening binary (which only caught SIGINT, and only between ticks).
KillSignal=SIGINT

# Logs go to the journal; view with:
#   journalctl --user -u scoracle-cognition -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scoracle-cognition

[Install]
WantedBy=default.target
