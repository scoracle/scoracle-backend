[Unit]
Description=Scoracle continual RSS coverage (Archbox)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__SCORACLE_REPO_ROOT__
EnvironmentFile=-__SCORACLE_REPO_ROOT__/.env.local
ExecStart=__SCORACLE_REPO_ROOT__/go/bin/pipeline -mode monitor
Restart=always
RestartSec=5
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scoracle-coverage

[Install]
WantedBy=default.target
